        <mxCell id="lg-1" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;1&amp;nbsp;&lt;/span&gt;&amp;nbsp;The platform team publishes a ResourceGraphDefinition: the API schema plus the graph of resources behind it." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="32" y="654" width="800" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lg-2" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;2&amp;nbsp;&lt;/span&gt;&amp;nbsp;kro registers a CRD from the RGD, so WebApp becomes a native Kubernetes API in the cluster." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="32" y="674" width="800" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lg-3" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;3&amp;nbsp;&lt;/span&gt;&amp;nbsp;A developer applies a WebApp instance with a few fields. Defaults and guardrails live in the RGD." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="32" y="694" width="800" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lg-4" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;4&amp;nbsp;&lt;/span&gt;&amp;nbsp;kro orders the graph and creates the ACK custom resources, passing outputs such as ARNs between them." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="32" y="714" width="800" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lg-5" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;5&amp;nbsp;&lt;/span&gt;&amp;nbsp;ACK calls the AWS APIs, creates the resources and corrects drift. kro and ACK do not use your worker nodes." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="32" y="734" width="800" height="18" as="geometry" />
        </mxCell>
