            <mxPoint x="910" y="664" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="key-flow-t" value="Authoring and applying" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;" parent="1" vertex="1">
