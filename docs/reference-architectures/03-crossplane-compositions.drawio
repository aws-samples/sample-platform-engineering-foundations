        <mxCell id="lg-4" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;4&amp;nbsp;&lt;/span&gt;&amp;nbsp;Crossplane applies the result as managed resources, one per AWS resource, and tracks them as one unit." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;" parent="1" vertex="1">
