        </mxCell>
        <mxCell id="lg-3" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;3&amp;nbsp;&lt;/span&gt;&amp;nbsp;Argo CD, installed and operated by you, syncs that repository into the cluster." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;" parent="1" vertex="1">
