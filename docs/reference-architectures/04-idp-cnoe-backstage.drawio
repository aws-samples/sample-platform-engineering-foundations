        <mxCell id="lg-1" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;1&amp;nbsp;&lt;/span&gt;&amp;nbsp;The developer signs in to Backstage through Keycloak, which also provides single sign-on for Argo CD." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;" parent="1" vertex="1">
