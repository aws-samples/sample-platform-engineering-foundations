        </mxCell>
        <mxCell id="lg-2" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;font-weight:bold;&quot;&gt;&amp;nbsp;2&amp;nbsp;&lt;/span&gt;&amp;nbsp;The developer picks a software template. Backstage scaffolds a repository in Gitea with app and infrastructure manifests." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;" parent="1" vertex="1">
