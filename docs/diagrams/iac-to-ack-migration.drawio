<mxfile host="Electron" version="29.6.1"><diagram name="IaC to ACK Migration" id="migration-1"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;font style=&quot;font-size:18px;&quot;&gt;&lt;b&gt;Migrating legacy IaC to ACK and kro&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666;&quot;&gt;Two fronts, same outcome: existing AWS resources under GitOps control without being recreated&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="800" height="50" as="geometry"/></mxCell><mxCell id="e-cfn-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=classic;" edge="1" parent="1" source="src-group" target="front1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-cfn-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=classic;" edge="1" parent="1" source="src-group" target="front2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-f1-out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#147EB4;strokeWidth=2;endArrow=classic;" edge="1" parent="1" source="front1" target="out-group"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-f2-out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=classic;" edge="1" parent="1" source="front2" target="out-group"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-out-aws" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E65100;strokeWidth=2;endArrow=classic;dashed=1;" edge="1" parent="1" source="out-group" target="aws-group"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="src-group" value="&lt;b&gt;1&lt;/b&gt;  Existing IaC" style="swimlane;startSize=26;fillColor=#F5F5F5;strokeColor=#999999;fontFamily=Helvetica;html=1;fontSize=11;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="230" height="230" as="geometry"/></mxCell><mxCell id="src-cfn" value="CloudFormation&lt;br&gt;(incl. nested stacks)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontFamily=Helvetica;html=1;fontSize=10;whiteSpace=wrap;" vertex="1" parent="src-group"><mxGeometry x="20" y="40" width="190" height="40" as="geometry"/></mxCell><mxCell id="src-tf" value="Terraform&lt;br&gt;(incl. modules)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontFamily=Helvetica;html=1;fontSize=10;whiteSpace=wrap;" vertex="1" parent="src-group"><mxGeometry x="20" y="95" width="190" height="40" as="geometry"/></mxCell><mxCell id="src-pulumi" value="Pulumi / Click-Ops&lt;br&gt;(console-created)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontFamily=Helvetica;html=1;fontSize=10;whiteSpace=wrap;" vertex="1" parent="src-group"><mxGeometry x="20" y="150" width="190" height="40" as="geometry"/></mxCell><mxCell id="front1" value="&lt;b&gt;2a&lt;/b&gt;  Front 1: Kiro Skill" style="swimlane;startSize=26;fillColor=#E6F2FF;strokeColor=#147EB4;fontFamily=Helvetica;html=1;fontSize=11;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="260" height="130" as="geometry"/></mxCell><mxCell id="f1-desc" value="Conversational, one resource&lt;br&gt;at a time. Reads live AWS&lt;br&gt;state, not your IaC.&lt;br&gt;&lt;br&gt;Best for: learning, one-offs" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="front1"><mxGeometry x="15" y="35" width="230" height="85" as="geometry"/></mxCell><mxCell id="front2" value="&lt;b&gt;2b&lt;/b&gt;  Front 2: AWS Transform custom" style="swimlane;startSize=26;fillColor=#E8F5E9;strokeColor=#2E7D32;fontFamily=Helvetica;html=1;fontSize=11;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="330" y="230" width="260" height="130" as="geometry"/></mxCell><mxCell id="f2-desc" value="Batch, whole repository.&lt;br&gt;Parses the IaC and emits&lt;br&gt;an ADOPTION_REPORT.md.&lt;br&gt;&lt;br&gt;Best for: migrating at scale" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="front2"><mxGeometry x="15" y="35" width="230" height="85" as="geometry"/></mxCell><mxCell id="out-group" value="&lt;b&gt;3&lt;/b&gt;  Generated manifests" style="swimlane;startSize=26;fillColor=#FFF3E0;strokeColor=#E65100;fontFamily=Helvetica;html=1;fontSize=11;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="670" y="90" width="250" height="230" as="geometry"/></mxCell><mxCell id="out-ack" value="&lt;b&gt;ACK adoption manifest&lt;/b&gt;&lt;br&gt;adoption-policy: adopt-or-create&lt;br&gt;deletion-policy: retain" style="rounded=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontFamily=Helvetica;html=1;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=6;" vertex="1" parent="out-group"><mxGeometry x="15" y="40" width="220" height="55" as="geometry"/></mxCell><mxCell id="out-kro" value="&lt;b&gt;kro ResourceGraphDefinition&lt;/b&gt;&lt;br&gt;from modules and nested stacks&lt;br&gt;(Front 2 only)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;fontFamily=Helvetica;html=1;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=6;" vertex="1" parent="out-group"><mxGeometry x="15" y="110" width="220" height="55" as="geometry"/></mxCell><mxCell id="out-todo" value="TODO(discovery) for identifiers&lt;br&gt;only resolvable at runtime" style="rounded=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontFamily=Helvetica;html=1;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=6;" vertex="1" parent="out-group"><mxGeometry x="15" y="178" width="220" height="40" as="geometry"/></mxCell><mxCell id="aws-group" value="&lt;b&gt;4&lt;/b&gt;  Existing AWS resources, now reconciled" style="swimlane;startSize=26;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontFamily=Helvetica;html=1;fontSize=11;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="670" y="370" width="250" height="110" as="geometry"/></mxCell><mxCell id="aws-desc" value="NOT recreated. NOT deleted.&lt;br&gt;ACK becomes source of truth&lt;br&gt;and reconciles from Git." style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="aws-group"><mxGeometry x="15" y="35" width="220" height="60" as="geometry"/></mxCell><mxCell id="warn" value="&lt;b&gt;The two rules that matter&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; deletion-policy: retain on every manifest. Without it, kubectl delete destroys the real AWS resource.&lt;br&gt;&lt;b&gt;2&lt;/b&gt; adopt-or-create reconciles AFTER adopting. If the spec is an approximation, it changes production quietly." style="rounded=1;fillColor=#FFEBEE;strokeColor=#C62828;fontFamily=Helvetica;html=1;fontSize=10;align=left;spacingLeft=8;spacingTop=6;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="600" height="70" as="geometry"/></mxCell><mxCell id="legend2" value="&lt;b&gt;Legend&lt;/b&gt;  Numbers 1-4 mark the migration stages, referenced in automation/README.md. Solid arrow = generates. Dashed arrow = adopts (no mutation)." style="rounded=1;fillColor=#FAFAFA;strokeColor=#999999;fontFamily=Helvetica;html=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="900" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
