rtal" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontFamily=Helvetica;html=1;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=54;verticalAlign=middle;" vertex="1" parent="cluster"><mxGeometry x="250" y="45" width="200" height="62" as="geometry"/></mxCell><mxCell id="backstage-icon" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://raw.githubusercontent.com/cncf/artwork/master/projects/backstage/icon/color/backstage-icon-color.svg;" vertex="1" parent="cluster"><mxGeometry x="258" y="56" width="40" height="40" as="geometry"/></mxCell><mxCell id="argocd" value="&lt;b&gt;4&lt;/b&gt;&amp;nbsp; Argo CD&lt;br&gt;GitOps delivery" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontFamily=Helvetica;html=1;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=54;verticalAlign=middle;" vertex="1" parent="cluster"><mxGeometry x="250" y="150" width="200" height="62" as="geometry"/></mxCell><mxCell id="argocd-icon" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://raw.githubusercontent.com/cncf/artwork/master/projects/argo/icon/color/argo-icon-color.svg;" vertex="1" parent="cluster"><mxGeometry x="258" y="161" width="40" height="40" as="geometry"/></mxCell><mxCell id="kro" value="&lt;b&gt;3&lt;/b&gt;&amp;nbsp; kro&lt;br&gt;ResourceGraphDefinitions" style="rounded=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontFamily=Helvetica;html=1;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=54;verticalAlign=middle;" vertex="1" parent="cluster"><mxGeometry x="480" y="45" width="230" height="62" as="geometry"/></mxCell><mxCell id="kro-icon" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#326CE5;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;prIcon=crd;" vertex="1" parent="cluster"><mxGeometry x="488" y="57" width="40" height="38" as="geometry"/></mxCell><mxCell id="ack" value="&lt;b&gt;4&lt;/b&gt;&amp;nbsp; ACK + Crossplane&lt;br&gt;AWS resource controllers" style="rounded=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontFamily=Helvetica;html=1;fontSize=10;whiteSpace=wrap;align=left;spacingLeft=96;verticalAlign=middle;" vertex="1" parent="cluster"><mxGeometry x="480" y="150" width="230" height="62" as="geometry"/></mxCell><mxCell id="ack-icon" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#326CE5;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;prIcon=crd;" vertex="1" parent="cluster"><mxGeometry x="488" y="162" width="38" height="36" as="geometry"/></mxCell><mxCell id="crossplane-icon" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=https://raw.githubusercontent.com/cncf/artwork/master/projects/crossplane/icon/color/crossplane-icon-color.svg;" vertex="1" parent="cluster"><mxGeometry x="532" y="161" width="38" height="38" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b&gt;CNOE reference implementation&lt;/b&gt;&amp;nbsp;-&amp;nbsp;github.com/cnoe-io/reference-implementation-aws" style="rounded=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Helvetica;html=1;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="514" width="440" height="42" as="geometry"/></mxCell><mxCell id="services" value="&lt;b&gt;6&lt;/b&gt;&amp;nbsp; AWS services" style="swimlane;startSize=26;fillColor=#FAFAFA;strokeColor=#999999;fontFamily=Helvetica;html=1;fontSize=11;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="820" y="230" width="360" height="250" as="geometry"/></mxCell><mxCell id="r53" value="Amazon Route 53" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;fillColor=#8C4FFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;fontFamily=Helvetica;" vertex="1" parent="services"><mxGeometry x="28" y="60" width="68" height="68" as="geometry"/></mxCell><mxCell id="sm" value="AWS Secrets Manager" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;fillColor=#DD344C;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;fontFamily=Helvetica;" vertex="1" parent="services"><mxGeometry x="146" y="60" width="68" height="68" as="geometry"/></mxCell><mxCell id="cw" value="Amazon CloudWatch" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;fillColor=#E7157B;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fontFamily=Helvetica;" vertex="1" parent="services"><mxGeometry x="264" y="60" width="68" height="68" as="geometry"/></mxCell><mxCell id="svc-note" value="DNS records, secrets consumed by Keycloak and External Secrets, logs and metrics from every controller" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="services"><mxGeometry x="28" y="175" width="304" height="60" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;1&lt;/b&gt; Participants reach the browser IDE over HTTPS through CloudFront and an Application Load Balancer.&amp;nbsp;&amp;nbsp;&lt;b&gt;2&lt;/b&gt; code-server runs on a dedicated Auto Mode NodePool.&amp;nbsp;&amp;nbsp;&lt;b&gt;3&lt;/b&gt; Backstage software templates create kro resources.&lt;br&gt;&lt;b&gt;4&lt;/b&gt; Argo CD syncs the CNOE reference repository (dashed line) and manages the resource controllers.&amp;nbsp;&amp;nbsp;&lt;b&gt;5&lt;/b&gt; Keycloak provides SSO, backed by Secrets Manager.&amp;nbsp;&amp;nbsp;&lt;b&gt;6&lt;/b&gt; Controllers provision Route 53 records and ship logs to CloudWatch.&lt;br&gt;kro and ACK carry the Kubernetes CRD icon because both work by defining and reconciling custom resources. Tool logos are loaded from the CNCF artwork repository." style="rounded=1;fillColor=#FAFAFA;strokeColor=#999999;fontFamily=Helvetica;html=1;fontSize=10;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="586" width="1160" height="78" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
