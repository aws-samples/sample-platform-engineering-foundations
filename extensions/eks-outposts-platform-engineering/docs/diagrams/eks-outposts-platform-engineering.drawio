;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;6&lt;/span&gt;&amp;nbsp;&lt;b style=&quot;font-size:11px&quot;&gt;Amazon EBS gp2 - data plane&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;platform-ebs-gp2 volumes on the Outpost&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="518" y="532" width="202" height="44" as="geometry" /></mxCell><mxCell id="ebs-warn" value="&lt;b&gt;&amp;#9888;&amp;#xFE0E;&amp;nbsp;Short disconnections only:&lt;/b&gt; no re&amp;#8209;replication without the Region" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="518" y="576" width="202" height="32" as="geometry" /></mxCell><mxCell id="storage-note" value="Bound claims keep running through short disconnections. Create, attach, resize and snapshot wait for the Region." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="738" y="536" width="145" height="66" as="geometry" /></mxCell><mxCell id="link-label" value="&lt;b&gt;Service Link&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="912" y="339" width="70" height="22" as="geometry" /></mxCell><mxCell id="disconnect-x" value="X" style="ellipse;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#D13212;strokeWidth=3;fontColor=#D13212;fontFamily=Helvetica;fontSize=13;fontStyle=1;spacing=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="932" y="364" width="30" height="30" as="geometry" /></mxCell><mxCell id="disconnect-label" value="&lt;b&gt;Network&lt;br&gt;disconnection&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;align=center;fontColor=#B0261A;" vertex="1" parent="1"><mxGeometry x="909" y="397" width="76" height="34" as="geometry" /></mxCell><mxCell id="region-title" value="&lt;b&gt;Regional lifecycle APIs&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="992" y="122" width="181" height="22" as="geometry" /></mxCell><mxCell id="r-eks" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=#ffffff;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fontFamily=Helvetica;fillColor=#ED7100;resIcon=mxgraph.aws4.eks;" vertex="1" parent="1"><mxGeometry x="1013" y="154" width="44" height="44" as="geometry" /></mxCell><mxCell id="r-eks-label" value="Amazon EKS&lt;br&gt;management APIs" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="989" y="202" width="92" height="38" as="geometry" /></mxCell><mxCell id="r-ebs" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=#ffffff;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fontFamily=Helvetica;fillColor=#7AA116;resIcon=mxgraph.aws4.elastic_block_store;" vertex="1" parent="1"><mxGeometry x="1109" y="154" width="44" height="44" as="geometry" /></mxCell><mxCell id="r-ebs-label" value="Amazon EBS&lt;br&gt;control plane&lt;br&gt;&lt;font color=&quot;#545B64&quot;&gt;create, attach, resize, snapshot, re-replication&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1085" y="202" width="92" height="70" as="geometry" /></mxCell><mxCell id="r-iam" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=#ffffff;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fontFamily=Helvetica;fillColor=#DD344C;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1"><mxGeometry x="1013" y="276" width="44" height="44" as="geometry" /></mxCell><mxCell id="r-iam-label" value="AWS STS / IAM&lt;br&gt;(Pod Identity)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="989" y="324" width="92" height="38" as="geometry" /></mxCell><mxCell id="r-ecr" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=#ffffff;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fontFamily=Helvetica;fillColor=#ED7100;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1"><mxGeometry x="1109" y="276" width="44" height="44" as="geometry" /></mxCell><mxCell id="r-ecr-label" value="Amazon ECR" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1085" y="324" width="92" height="38" as="geometry" /></mxCell><mxCell id="r-s3" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=#ffffff;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fontFamily=Helvetica;fillColor=#7AA116;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1013" y="376" width="44" height="44" as="geometry" /></mxCell><mxCell id="r-s3-label" value="Amazon S3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="989" y="424" width="92" height="38" as="geometry" /></mxCell><mxCell id="r-ddb" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=#ffffff;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fontFamily=Helvetica;fillColor=#C925D1;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="1109" y="376" width="44" height="44" as="geometry" /></mxCell><mxCell id="r-ddb-label" value="Amazon DynamoDB" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1085" y="424" width="92" height="38" as="geometry" /></mxCell><mxCell id="region-note" value="Used for cluster management, identity, images, volumes and Crossplane-managed resources. These calls stop during a disconnection; local paths keep running through short disconnections." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontColor=#545B64;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="995" y="476" width="178" height="100" as="geometry" /></mxCell><mxCell id="legend-1" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;1&lt;/span&gt;&amp;nbsp;Choose one IaC front; both create equivalent network, cluster, nodes and add-ons." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="36" y="682" width="560" height="24" as="geometry" /></mxCell><mxCell id="legend-2" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;2&lt;/span&gt;&amp;nbsp;Each front emits the same platform contract; the shared bootstrap reads it." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="36" y="710" width="560" height="24" as="geometry" /></mxCell><mxCell id="legend-3" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;3&lt;/span&gt;&amp;nbsp;The Kubernetes API and etcd run on the Outpost and keep serving through short disconnections." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="36" y="738" width="560" height="24" as="geometry" /></mxCell><mxCell id="legend-4" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;4&lt;/span&gt;&amp;nbsp;Harbor and Gitea keep images and desired state on the local network." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="616" y="682" width="560" height="24" as="geometry" /></mxCell><mxCell id="legend-5" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;5&lt;/span&gt;&amp;nbsp;Argo CD reconciles observability, DNS and NetworkPolicies from local Git." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="616" y="710" width="560" height="24" as="geometry" /></mxCell><mxCell id="legend-6" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;6&lt;/span&gt;&amp;nbsp;Apps, Crossplane and bound EBS claims keep running through short disconnections; Regional changes wait." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="616" y="738" width="560" height="24" as="geometry" /></mxCell><mxCell id="key-local" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#232F3E;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="787" as="sourcePoint" /><mxPoint x="84" y="787" as="targetPoint" /></mxGeometry></mxCell><mxCell id="key-local-text" value="Solid dark: local path" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="92" y="777" width="150" height="20" as="geometry" /></mxCell><mxCell id="key-argo" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#147EBA;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="787" as="sourcePoint" /><mxPoint x="294" y="787" as="targetPoint" /></mxGeometry></mxCell><mxCell id="key-argo-text" value="Solid thick: Argo CD sync from local Git" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="302" y="777" width="230" height="20" as="geometry" /></mxCell><mxCell id="key-link" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#545B64;strokeWidth=2.5;dashed=1;dashPattern=3 2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="545" y="787" as="sourcePoint" /><mxPoint x="589" y="787" as="targetPoint" /></mxGeometry></mxCell><mxCell id="key-link-text" value="Dashed: Service Link to the parent Region" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="597" y="777" width="240" height="20" as="geometry" /></mxCell><mxCell id="key-x" value="X" style="ellipse;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#D13212;strokeWidth=3;fontColor=#D13212;fontFamily=Helvetica;fontSize=10;fontStyle=1;spacing=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="849" y="776" width="23" height="23" as="geometry" /></mxCell><mxCell id="key-x-text" value="Circled X: Regional calls stop, local paths continue" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="878" y="777" width="292" height="20" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>