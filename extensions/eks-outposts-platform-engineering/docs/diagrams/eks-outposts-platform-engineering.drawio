        </mxCell>
        <mxCell id="legend-1" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;1&lt;/span&gt;&amp;nbsp;Choose CloudFormation or Terraform; both create the equivalent infrastructure." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="535" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-2" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;2&lt;/span&gt;&amp;nbsp;Both fronts emit the same platform contract for the shared bootstrap." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="696" width="535" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-3" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;3&lt;/span&gt;&amp;nbsp;The Kubernetes API and etcd run locally on the Outpost." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="732" width="535" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-4" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;4&lt;/span&gt;&amp;nbsp;Gitea and Harbor keep desired state and images on the local network." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="610" y="660" width="535" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-5" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;5&lt;/span&gt;&amp;nbsp;Argo CD, metrics, logs, DNS and policy reconciliation continue locally." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="610" y="696" width="535" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend-6" value="&lt;span style=&quot;display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;&quot;&gt;6&lt;/span&gt;&amp;nbsp;Applications and pre-created EBS claims keep running; Regional mutations wait for reconnection." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="610" y="732" width="535" height="28" as="geometry" />
