        <mxCell id="disconnect-label" value="&lt;b&gt;When disconnected&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6b7a&quot;&gt;Regional API calls stop;&lt;br&gt;local paths continue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF4F2;strokeColor=#D13212;fontFamily=Helvetica;fontSize=9;fontColor=#232F3E;" vertex="1" parent="1">
