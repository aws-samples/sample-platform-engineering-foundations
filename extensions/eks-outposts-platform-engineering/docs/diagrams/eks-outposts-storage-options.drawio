<mxfile host="Electron" version="29.6.1"><diagram name="Page-1" id="eks-outposts-storage"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value='&lt;b style="font-size:18px"&gt;Choose the Outpost storage configuration by disconnect duration&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#545B64"&gt;An Outpost is configured with Amazon EBS or with instance store. This extension implements the EBS-backed configuration, designed for short Service Link disconnections.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1160" height="52" as="geometry" /></mxCell><mxCell id="short" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;container=0;pointerEvents=0;strokeColor=#545B64;fillColor=#FFFFFF;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="555" height="510" as="geometry" /></mxCell><mxCell id="short-icon" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=#ffffff;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fontFamily=Helvetica;fillColor=#7AA116;resIcon=mxgraph.aws4.elastic_block_store;" vertex="1" parent="1"><mxGeometry x="34" y="104" width="44" height="44" as="geometry" /></mxCell><mxCell id="short-title" value='&lt;span style="display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;"&gt;1&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:13px"&gt;Short disconnections&lt;/b&gt;&lt;br&gt;&lt;font color="#545B64"&gt;EBS-backed Outpost (this extension)&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="88" y="100" width="473" height="52" as="geometry" /></mxCell><mxCell id="short-status" value="&lt;b&gt;&amp;#10003;&amp;nbsp; Implemented&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;fillColor=#F8F9FA;strokeColor=#232F3E;strokeWidth=1.5;dashed=0;" vertex="1" parent="1"><mxGeometry x="34" y="162" width="527" height="26" as="geometry" /></mxCell><mxCell id="short-where" value="&lt;b&gt;Where it lives&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="34" y="200" width="200" height="20" as="geometry" /></mxCell><mxCell id="short-loc0" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;container=0;pointerEvents=0;strokeColor=#ED7100;fillColor=#FFF7ED;dashed=0;" vertex="1" parent="1"><mxGeometry x="34" y="224" width="527" height="54" as="geometry" /></mxCell><mxCell id="short-loc0-icon" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=#ffffff;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fontFamily=Helvetica;fillColor=#ED7100;resIcon=mxgraph.aws4.outposts;" vertex="1" parent="1"><mxGeometry x="42" y="239" width="24" height="24" as="geometry" /></mxCell><mxCell id="short-loc0-text" value='&lt;b&gt;On the Outpost&lt;/b&gt;&lt;br&gt;&lt;font color="#545B64"&gt;Amazon EBS gp2 data plane: platform-ebs-gp2 volumes and their data&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="227" width="481" height="48" as="geometry" /></mxCell><mxCell id="short-loc1" value="" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=#F0FBFB;dashed=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="34" y="286" width="527" height="54" as="geometry" /></mxCell><mxCell id="short-loc1-text" value='&lt;b&gt;AWS Region, over the Service Link&lt;/b&gt;&lt;br&gt;&lt;font color="#545B64"&gt;Amazon EBS control plane: create, attach, resize, snapshot, re-replication&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="289" width="481" height="48" as="geometry" /></mxCell><mxCell id="short-disc" value="&lt;b&gt;While the Service Link is down&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="34" y="420" width="300" height="20" as="geometry" /></mxCell><mxCell id="short-item0" value="&lt;b&gt;&amp;#10003;&amp;nbsp; Keeps working&lt;/b&gt;&lt;br&gt;Bound claims and attached EBS volumes keep running." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="34" y="446" width="527" height="44" as="geometry" /></mxCell><mxCell id="short-item1" value="&lt;b&gt;&amp;#10007;&amp;nbsp; Waits for the Region&lt;/b&gt;&lt;br&gt;Create, attach, resize and snapshot calls, and re-replication after a hardware failure." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="34" y="496" width="527" height="44" as="geometry" /></mxCell><mxCell id="short-item2" value="&lt;b&gt;&amp;#9888;&amp;#xFE0E;&amp;nbsp; Risk grows with disconnect duration&lt;/b&gt;&lt;br&gt;Durability and availability risk rises the longer the link is down. Restore the Service Link promptly." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="34" y="546" width="527" height="44" as="geometry" /></mxCell><mxCell id="long" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;container=0;pointerEvents=0;strokeColor=#545B64;fillColor=#FFFFFF;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="625" y="90" width="555" height="510" as="geometry" /></mxCell><mxCell id="long-icon" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=#ffffff;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fontFamily=Helvetica;fillColor=#ED7100;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1"><mxGeometry x="639" y="104" width="44" height="44" as="geometry" /></mxCell><mxCell id="long-title" value='&lt;span style="display:inline-block;box-sizing:border-box;width:19px;height:19px;border-radius:50%;text-align:center;line-height:19px;font-size:11px;font-weight:bold;vertical-align:middle;background:#FF9900;color:#232F3E;"&gt;2&lt;/span&gt;&amp;nbsp;&lt;b style="font-size:13px"&gt;Prolonged disconnections&lt;/b&gt;&lt;br&gt;&lt;font color="#545B64"&gt;Instance-store Outpost, no Amazon EBS&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="693" y="100" width="473" height="52" as="geometry" /></mxCell><mxCell id="long-status" value="&lt;b&gt;&amp;#9671;&amp;nbsp; Not implemented by this extension&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;fillColor=#F8F9FA;strokeColor=#232F3E;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="639" y="162" width="527" height="26" as="geometry" /></mxCell><mxCell id="long-where" value="&lt;b&gt;Where it lives&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="639" y="200" width="200" height="20" as="geometry" /></mxCell><mxCell id="long-loc0" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;container=0;pointerEvents=0;strokeColor=#ED7100;fillColor=#FFF7ED;dashed=0;" vertex="1" parent="1"><mxGeometry x="639" y="224" width="527" height="54" as="geometry" /></mxCell><mxCell id="long-loc0-icon" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=#ffffff;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fontFamily=Helvetica;fillColor=#ED7100;resIcon=mxgraph.aws4.outposts;" vertex="1" parent="1"><mxGeometry x="647" y="239" width="24" height="24" as="geometry" /></mxCell><mxCell id="long-loc0-text" value='&lt;b&gt;On the Outpost (updated local-cluster architecture)&lt;/b&gt;&lt;br&gt;&lt;font color="#545B64"&gt;EC2 instance store for the AWS-managed control plane and etcd&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="679" y="227" width="481" height="48" as="geometry" /></mxCell><mxCell id="long-loc1" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;container=0;pointerEvents=0;strokeColor=#ED7100;fillColor=#FFF7ED;dashed=0;" vertex="1" parent="1"><mxGeometry x="639" y="286" width="527" height="54" as="geometry" /></mxCell><mxCell id="long-loc1-icon" value="" style="sketch=0;outlineConnect=0;gradientColor=none;strokeColor=#ffffff;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fontFamily=Helvetica;fillColor=#ED7100;resIcon=mxgraph.aws4.outposts;" vertex="1" parent="1"><mxGeometry x="647" y="301" width="24" height="24" as="geometry" /></mxCell><mxCell id="long-loc1-text" value='&lt;b&gt;On the Outpost, ephemeral data only&lt;/b&gt;&lt;br&gt;&lt;font color="#545B64"&gt;EC2 Local Instance Store CSI: data is lost with the node&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="679" y="289" width="481" height="48" as="geometry" /></mxCell><mxCell id="long-loc2" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;container=0;pointerEvents=0;strokeColor=#545B64;fillColor=#F8F9FA;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="639" y="348" width="527" height="54" as="geometry" /></mxCell><mxCell id="long-loc2-icon" value="" style="sketch=0;outlineConnect=0;dashed=0;aspect=fixed;html=1;shape=mxgraph.aws4.corporate_data_center;fillColor=#545B64;strokeColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="647" y="363" width="24" height="24" as="geometry" /></mxCell><mxCell id="long-loc2-text" value='&lt;b&gt;Customer data center, outside the rack&lt;/b&gt;&lt;br&gt;&lt;font color="#545B64"&gt;Durable workload data: on-premises NetApp ONTAP array with Trident CSI&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="679" y="351" width="481" height="48" as="geometry" /></mxCell><mxCell id="long-disc" value="&lt;b&gt;While the Service Link is down&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="639" y="420" width="300" height="20" as="geometry" /></mxCell><mxCell id="long-item0" value="&lt;b&gt;&amp;#10003;&amp;nbsp; Not affected by the EBS re-replication limitation&lt;/b&gt;&lt;br&gt;The control plane and etcd run on instance store on the Outpost, with no Amazon EBS volumes." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="639" y="446" width="527" height="44" as="geometry" /></mxCell><mxCell id="long-item1" value="&lt;b&gt;&amp;#10007;&amp;nbsp; Instance store is not durable workload storage&lt;/b&gt;&lt;br&gt;Local Instance Store CSI is ephemeral: data is lost with the node." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="639" y="496" width="527" height="44" as="geometry" /></mxCell><mxCell id="long-item2" value="&lt;b&gt;&amp;#9671;&amp;nbsp; Durable data needs an external array (candidate, not deployed)&lt;/b&gt;&lt;br&gt;NetApp ONTAP with Trident CSI through Outposts third-party block storage." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="639" y="546" width="527" height="44" as="geometry" /></mxCell><mxCell id="or-pill" value="&lt;b&gt;OR&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=#545B64;" vertex="1" parent="1"><mxGeometry x="582" y="116" width="36" height="20" as="geometry" /></mxCell><mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;container=0;pointerEvents=0;strokeColor=#ED7100;fillColor=#FFFFFF;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="1160" height="124" as="geometry" /></mxCell><mxCell id="legend-title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="36" y="628" width="200" height="20" as="geometry" /></mxCell><mxCell id="legend-s0" value="&lt;b&gt;&amp;#10003;&lt;/b&gt;&amp;nbsp; Implemented (solid border), or keeps working while disconnected" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="36" y="656" width="400" height="20" as="geometry" /></mxCell><mxCell id="legend-s1" value="&lt;b&gt;&amp;#9671;&lt;/b&gt;&amp;nbsp; Not implemented by this extension (dashed border)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="456" y="656" width="320" height="20" as="geometry" /></mxCell><mxCell id="legend-warn" value="&lt;b&gt;&amp;#9888;&amp;#xFE0E;&lt;/b&gt;&amp;nbsp; Risk or limitation" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="796" y="656" width="180" height="20" as="geometry" /></mxCell><mxCell id="legend-k0" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;container=0;pointerEvents=0;strokeColor=#ED7100;fillColor=#FFF7ED;dashed=0;" vertex="1" parent="1"><mxGeometry x="36" y="682" width="40" height="22" as="geometry" /></mxCell><mxCell id="legend-k0-text" value="On the Outpost" style="text;html=1;whi