    {"id": "language-enum", "set": {"/language": "fr"}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/language", "code": "enum"}]},
    {"id": "no-skills", "set": {"/skills": []}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/skills", "code": "too_few"}]},
    {"id": "no-instructions", "set": {"/instructions": []}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/instructions", "code": "too_few"}]},
    {"id": "instruction-too-long", "set": {"/instructions/0": "Liste os pods e explique cada um com muito detalhe, incluindo eventos, logs, condições, owner references, labels, anotações, limites de recursos, requests, probes, imagens, tags, volumes, montagens, service accounts, tolerations, afinidades, node selectors, prioridades, preempção, QoS, histórico de restarts, último estado de término, códigos de saída, sinais, tempo de vida, idade e qualquer outro sinal relevante até esgotar a análise."}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/instructions/0", "code": "too_long"}]},
    {"id": "display-name-too-short", "set": {"/displayName": "ok"}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/displayName", "code": "too_short"}]},
    {"id": "skill-unknown-field", "set": {"/skills/0/inputModes": ["text"]}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/skills/0/inputModes", "code": "unknown_field"}]},
    {"id": "duplicate-skill-id", "set": {"/skills/1": {"id": "pod-health", "name": "Outra skill", "description": "Mesmo id da primeira skill, o que quebra o agent card.", "examples": []}}, "callerIsAdmin": false, "schemaExpressible": false, "expected": [{"path": "/skills/1/id", "code": "duplicate"}]},
    {"id": "too-many-skills", "set": {"/skills/1": {"id": "s2", "name": "Skill dois", "description": "Segunda skill válida do agent.", "examples": []}, "/skills/2": {"id": "s3", "name": "Skill três", "description": "Terceira skill válida do agent.", "examples": []}, "/skills/3": {"id": "s4", "name": "Skill quatro", "description": "Quarta skill, acima do limite.", "examples": []}}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/skills", "code": "too_many"}]}
  ]
}
