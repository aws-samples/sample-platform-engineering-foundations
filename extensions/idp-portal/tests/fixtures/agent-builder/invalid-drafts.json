{
  "description": "Each case applies 'remove' and then 'set' (JSON Pointer; setting an array index equal to its length appends) to the base draft and carries exactly ONE defect. The validator must return exactly the listed (path, code) set. schemaExpressible=false marks rules that only the stdlib validator enforces; the JSON Schema may accept those drafts.",
  "base": "valid-pod-health.draft.json",
  "codes": ["schema_version", "required", "unknown_field", "type", "too_short", "too_long", "too_few", "too_many", "pattern", "not_single_line", "secret_like", "enum", "duplicate", "tool_not_allowed", "reserved_name"],
  "cases": [
    {"id": "unknown-field-image", "set": {"/image": "nginx:latest"}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/image", "code": "unknown_field"}]},
    {"id": "kind-injection", "set": {"/kind": "ClusterRoleBinding"}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/kind", "code": "unknown_field"}]},
    {"id": "namespace-injection", "set": {"/namespace": "kube-system"}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/namespace", "code": "unknown_field"}]},
    {"id": "write-tool", "set": {"/tools": ["k8s_apply_manifest"]}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/tools/0", "code": "tool_not_allowed"}]},
    {"id": "duplicate-tool", "set": {"/tools": ["k8s_get_events", "k8s_get_events"]}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/tools/1", "code": "duplicate"}]},
    {"id": "tools-not-array", "set": {"/tools": "k8s_get_events"}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/tools", "code": "type"}]},
    {"id": "name-without-prefix", "set": {"/name": "pod-health"}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/name", "code": "pattern"}]},
    {"id": "name-uppercase", "set": {"/name": "ab-Pod-Health"}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/name", "code": "pattern"}]},
    {"id": "fixture-prefix-non-admin", "set": {"/name": "ab-fx-a1b2c3"}, "callerIsAdmin": false, "schemaExpressible": false, "expected": [{"path": "/name", "code": "reserved_name"}]},
    {"id": "fixture-prefix-admin", "set": {"/name": "ab-fx-a1b2c3"}, "callerIsAdmin": true, "schemaExpressible": true, "expected": []},
    {"id": "token-in-instruction", "set": {"/instructions/1": "Use token: abc123 para autenticar no cluster antes de listar."}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/instructions/1", "code": "secret_like"}]},
    {"id": "aws-key-in-description", "set": {"/description": "Lê dados com a chave AKIAABCDEFGHIJKLMNOP em todos os namespaces."}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/description", "code": "secret_like"}]},
    {"id": "gitlab-pat-in-instruction", "set": {"/instructions/1": "Autentique no GitLab com glpat-FIXTURE-NAO-E-CREDENCIAL-REAL antes de listar."}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/instructions/1", "code": "secret_like"}]},
    {"id": "github-pat-in-instruction", "set": {"/instructions/1": "Clone o repo usando ghp_FIXTURENAOECREDENCIALREAL00 antes de listar."}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/instructions/1", "code": "secret_like"}]},
    {"id": "slack-bot-token-in-instruction", "set": {"/instructions/1": "Poste no Slack com xoxb-FIXTURE-NAO-E-CREDENCIAL-REAL e siga em frente."}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/instructions/1", "code": "secret_like"}]},
    {"id": "slack-user-token-in-description", "set": {"/description": "Resume canais do Slack com xoxp-FIXTURE-NAO-E-CREDENCIAL-REAL por namespace."}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/description", "code": "secret_like"}]},
    {"id": "jwt-in-instruction", "set": {"/instructions/1": "Chame o gateway com eyJGSVhUVVJFLU5BTw.eyJGSVhUVVJFLU5BTw.RklYVFVSRS1OQU8tRQ e siga."}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/instructions/1", "code": "secret_like"}]},
    {"id": "prefix-without-a-token-is-not-a-credential", "set": {"/instructions/1": "Explique ao usuario que um glpat- do GitLab nunca entra no rascunho."}, "callerIsAdmin": false, "schemaExpressible": true, "expected": []},
    {"id": "multiline-instruction", "set": {"/instructions/0": "Pergunte o namespace.\nDepois liste os pods."}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/instructions/0", "code": "not_single_line"}]},
    {"id": "leading-space", "set": {"/displayName": " Saúde dos pods"}, "callerIsAdmin": false, "schemaExpressible": true, "expected": [{"path": "/displayName", "code": "not_single_line"}]},
