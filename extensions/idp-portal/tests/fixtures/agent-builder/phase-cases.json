{
  "description": "Golden cases for agentBuilderPhase(). Rules are evaluated in the order of docs/agent-platform/design-agent-builder.md, section 'Fase observada', first match wins. now and timestamps are epoch seconds. budgetSeconds is the fixed convergence budget after merge. Rule 8 (DISABLED) needs replicas 0 in the spec, observedGeneration == generation and podReplicas == 0 (pods of the agent Deployment read by the cluster-api); podReplicas null or absent never yields DISABLED (review 2026-10-13, round 3, R3-1).",
  "budgetSeconds": 900,
  "cases": [
    {"id": "failed", "op": "create", "request": {"status": "failed", "mergedAt": null}, "agent": null, "a2a": null, "now": 1000, "expected": "FAILED"},
    {"id": "closed", "op": "create", "request": {"status": "closed", "mergedAt": null}, "agent": null, "a2a": null, "now": 1000, "expected": "CLOSED"},
    {"id": "pending", "op": "create", "request": {"status": "pending", "mergedAt": null}, "agent": null, "a2a": null, "now": 1000, "expected": "REQUESTED"},
    {"id": "processing", "op": "create", "request": {"status": "processing", "mergedAt": null}, "agent": null, "a2a": null, "now": 1000, "expected": "REQUESTED"},
    {"id": "mr-open", "op": "create", "request": {"status": "mr_open", "mergedAt": null}, "agent": null, "a2a": null, "now": 1000, "expected": "IN_REVIEW"},
    {"id": "merged-not-synced-yet", "op": "create", "request": {"status": "merged", "mergedAt": 1000}, "agent": null, "a2a": null, "now": 1899, "expected": "SYNCING"},
    {"id": "merged-sync-stalled", "op": "create", "request": {"status": "merged", "mergedAt": 1000}, "agent": null, "a2a": null, "now": 1900, "expected": "SYNC_STALLED"},
    {"id": "controller-rejected", "op": "create", "request": {"status": "merged", "mergedAt": 1000}, "agent": {"createdAt": 1100, "accepted": "False", "ready": "Unknown", "generation": 1, "observedGeneration": 1, "replicas": null}, "a2a": null, "now": 1200, "expected": "REJECTED"},
    {"id": "starting", "op": "create", "request": {"status": "merged", "mergedAt": 1000}, "agent": {"createdAt": 1100, "accepted": "True", "ready": "False", "generation": 1, "observedGeneration": 1, "replicas": null}, "a2a": null, "now": 1500, "expected": "STARTING"},
    {"id": "stalled", "op": "create", "request": {"status": "merged", "mergedAt": 1000}, "agent": {"createdAt": 1100, "accepted": "True", "ready": "False", "generation": 1, "observedGeneration": 1, "replicas": null}, "a2a": null, "now": 1900, "expected": "STALLED"},
    {"id": "ready-old-generation", "op": "create", "request": {"status": "merged", "mergedAt": 1000}, "agent": {"createdAt": 1100, "accepted": "True", "ready": "True", "generation": 2, "observedGeneration": 1, "replicas": null}, "a2a": null, "now": 1500, "expected": "STARTING"},
    {"id": "ready", "op": "create", "request": {"status": "merged", "mergedAt": 1000}, "agent": {"createdAt": 1100, "accepted": "True", "ready": "True", "generation": 1, "observedGeneration": 1, "replicas": null}, "a2a": null, "now": 1500, "expected": "READY"},
    {"id": "ready-test-running", "op": "create", "request": {"status": "merged", "mergedAt": 1000}, "agent": {"createdAt": 1100, "accepted": "True", "ready": "True", "generation": 1, "observedGeneration": 1, "replicas": null}, "a2a": {"state": "working", "hasText": false}, "now": 1500, "expected": "READY"},
    {"id": "verified", "op": "create", "request": {"status": "merged", "mergedAt": 1000}, "agent": {"createdAt": 1100, "accepted": "True", "ready": "True", "generation": 1, "observedGeneration": 1, "replicas": null}, "a2a": {"state": "completed", "hasText": true}, "now": 1500, "expected": "VERIFIED"},
    {"id": "test-completed-empty", "op": "create", "request": {"status": "merged", "mergedAt": 1000}, "agent": {"createdAt": 1100, "accepted": "True", "ready": "True", "generation": 1, "observedGeneration": 1, "replicas": null}, "a2a": {"state": "completed", "hasText": false}, "now": 1500, "expected": "TEST_FAILED"},
    {"id": "test-input-required", "op": "create", "request": {"status": "merged", "mergedAt": 1000}, "agent": {"createdAt": 1100, "accepted": "True", "ready": "True", "generation": 1, "observedGeneration": 1, "replicas": null}, "a2a": {"state": "input-required", "hasText": true}, "now": 1500, "expected": "TEST_FAILED"},
    {"id": "disable-in-review", "op": "disable", "request": {"status": "mr_open", "mergedAt": null}, "agent": {"createdAt": 100, "accepted": "True", "ready": "True", "generation": 1, "observedGeneration": 1, "replicas": null}, "a2a": null, "now": 1000, "expected": "IN_REVIEW"},
    {"id": "disable-merged-not-applied", "op": "disable", "request": {"status": "merged", "mergedAt": 1000}, "agent": {"createdAt": 100, "accepted": "True", "ready": "True", "generation": 1, "observedGeneration": 1, "replicas": null}, "a2a": null, "now": 1200, "expected": "SYNCING"},
    {"id": "disable-merged-stalled", "op": "disable", "request": {"status": "merged", "mergedAt": 1000}, "agent": {"createdAt": 100, "accepted": "True", "ready": "True", "generation": 1, "observedGeneration": 1, "replicas": null}, "a2a": null, "now": 1900, "expected": "SYNC_STALLED"},
