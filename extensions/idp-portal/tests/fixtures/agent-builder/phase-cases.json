    {"id": "disable-applied-not-observed", "op": "disable", "request": {"status": "merged", "mergedAt": 1000}, "agent": {"createdAt": 100, "accepted": "True", "ready": "True", "generation": 2, "observedGeneration": 1, "replicas": 0, "podReplicas": 1}, "a2a": null, "now": 1100, "expected": "SYNCING"},
    {"id": "disable-not-observed-pods-already-zero", "op": "disable", "request": {"status": "merged", "mergedAt": 1000}, "agent": {"createdAt": 100, "accepted": "True", "ready": "True", "generation": 2, "observedGeneration": 1, "replicas": 0, "podReplicas": 0}, "a2a": null, "now": 1100, "expected": "SYNCING"},
    {"id": "disable-observed-pod-still-running", "op": "disable", "request": {"status": "merged", "mergedAt": 1000}, "agent": {"createdAt": 100, "accepted": "True", "ready": "True", "generation": 2, "observedGeneration": 2, "replicas": 0, "podReplicas": 1}, "a2a": null, "now": 1100, "expected": "SYNCING"},
    {"id": "disable-pods-unknown", "op": "disable", "request": {"status": "merged", "mergedAt": 1000}, "agent": {"createdAt": 100, "accepted": "True", "ready": "False", "generation": 2, "observedGeneration": 2, "replicas": 0, "podReplicas": null}, "a2a": null, "now": 1100, "expected": "SYNCING"},
    {"id": "disable-pods-never-reach-zero", "op": "disable", "request": {"status": "merged", "mergedAt": 1000}, "agent": {"createdAt": 100, "accepted": "True", "ready": "True", "generation": 2, "observedGeneration": 2, "replicas": 0, "podReplicas": 1}, "a2a": null, "now": 1900, "expected": "SYNC_STALLED"},
    {"id": "disabled-from-list-not-observed", "op": "create", "request": null, "agent": {"createdAt": 100, "accepted": "True", "ready": "True", "generation": 2, "observedGeneration": 1, "replicas": 0, "podReplicas": 1}, "a2a": null, "now": 500, "expected": "STARTING"},
    {"id": "disabled-from-list-not-observed-old-agent", "op": "create", "request": null, "agent": {"createdAt": 100, "accepted": "True", "ready": "True", "generation": 2, "observedGeneration": 1, "replicas": 0, "podReplicas": 1}, "a2a": null, "now": 5000, "expected": "STALLED"},
    {"id": "disabled-from-list", "op": "create", "request": null, "agent": {"createdAt": 100, "accepted": "True", "ready": "False", "generation": 2, "observedGeneration": 2, "replicas": 0, "podReplicas": 0}, "a2a": null, "now": 5000, "expected": "DISABLED"},
    {"id": "no-request-ready", "op": "create", "request": null, "agent": {"createdAt": 100, "accepted": "True", "ready": "True", "generation": 1, "observedGeneration": 1, "replicas": null}, "a2a": null, "now": 5000, "expected": "READY"},
    {"id": "no-request-no-agent", "op": "create", "request": null, "agent": null, "a2a": null, "now": 5000, "expected": "NOT_FOUND"}
  ]
