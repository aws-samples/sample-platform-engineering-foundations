  "description": "DynamoDB table for order events, retained on deletion.",
  "descriptionPt": "Tabela DynamoDB para eventos de pedido, retida na exclusão.",
  "owner": "platform-team",
  "engine": "ack",
  "pattern": "kro + ACK DynamoDB",
