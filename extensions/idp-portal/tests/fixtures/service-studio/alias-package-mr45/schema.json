{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DynamoDBTable",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "examples": [
        "example"
      ]
    },
    "hashKeyName": {
      "type": "string",
      "default": "id"
    },
    "hashKeyType": {
      "type": "string",
      "default": "N"
    },
    "environment": {
      "type": "string",
      "default": "dev"
    }
  },
  "additionalProperties": false
}
