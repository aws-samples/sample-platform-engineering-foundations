                }
              }
            ]
          }
        }
      },
      "expectMessage": "toolNames must hold 1 to 5 names",
      "why": "Passa do limite de 5 do catálogo."
    },
    {
      "id": "tools-two-entries",
      "patch": {
        "spec": {
          "declarative": {
            "tools": [
              {
                "type": "McpServer",
                "mcpServer": {
                  "apiGroup": "kagent.dev",
                  "kind": "RemoteMCPServer",
                  "name": "builder-readonly-tool-server",
                  "toolNames": [
                    "k8s_get_resources"
                  ]
                }
              },
              {
                "type": "McpServer",
                "mcpServer": {
                  "apiGroup": "kagent.dev",
                  "kind": "RemoteMCPServer",
                  "name": "builder-readonly-tool-server",
                  "toolNames": [
                    "k8s_get_events"
                  ]
                }
              }
            ]
          }
        }
      },
      "expectMessage": "at most one tools entry",
      "why": "Dois blocos de tools, ambos apontando para o tool server certo e com tool do catalogo: nenhuma outra validacao reclama, so o limite de um bloco. Isola a regra que esta sendo testada, em vez de deixar outra validacao negar antes."
    },
    {
      "id": "name-without-prefix",
      "patch": {
        "metadata": {
          "name": "pod-health"
        }
      },
      "expectMessage": "must start with the ab- prefix",
      "why": "Sem o prefixo, o agent sai do alcance de toda regra que usa o prefixo. Casa pelo label de managed-by."
    },
    {
      "id": "namespace-outside-kagent",
      "patch": {
        "metadata": {
          "namespace": "default"
        }
      },
      "expectMessage": "builder agents live only in the kagent namespace",
      "why": "Agent ab-* aplicado por kubectl em outro namespace. Com o binding restrito a kagent ele nem era avaliado; sem o seletor, a regra de namespace reprova. Achado 5 do review de 13/10/2026."
    },
    {
      "id": "missing-requester-label",
      "remove": [
        [
          "metadata",
          "labels",
          "platform.appmod/requester"
        ]
      ],
      "expectMessage": "platform.appmod/requester",
      "why": "Sem requester não há atribuição: quebra a invariante I8 e o limite por pessoa."
    },
    {
      "id": "empty-requester-label",
      "patch": {
        "metadata": {
          "labels": {
            "platform.appmod/requester": ""
          }
        }
      },
      "expectMessage": "platform.appmod/requester",
      "why": "Requester vazio passa em verificação de presença e não atribui nada."
    },
    {
      "id": "missing-managed-by-label",
      "remove": [
        [
          "metadata",
          "labels",
          "app.kubernetes.io/managed-by"
        ]
      ],
      "expectMessage": "app.kubernetes.io/managed-by",
      "why": "Casa pelo prefixo ab- do nome. Prova que remover o label não escapa da policy, e que o label é exigido de volta."
    },
    {
      "id": "compiler-annotation-wrong",
      "patch": {
        "metadata": {
          "annotations": {
            "platform.appmod/compiler": "hand-written"
          }
        }
      },
      "expectMessage": "platform.appmod/compiler",
      "why": "Manifest não produzido pelo compiler."
    },
    {
      "id": "fixture-label-without-fx-name",
      "patch": {
        "metadata": {
          "labels": {
            "platform.appmod/fixture": "true"
          }
        }
      },
      "expectMessage": "ab-fx- name prefix",
      "why": "Agent normal disfarçado de fixture: entraria no caminho de remoção de fixture, que é o único delete autorizado neste run."
    },
    {
      "id": "fx-name-without-fixture-label",
      "patch": {
        "metadata": {
          "name": "ab-fx-w7run2"
        }
      },
      "expectMessage": "ab-fx- name prefix",
      "why": "Fixture sem o label: escapa da limpeza do fim do run e fica órfã."
    },
    {
      "id": "declarative-runtime-go",
      "patch": {
        "spec": {
          "declarative": {
            "runtime": "go"
          }
        }
      },
      "expectMessage": "runtime must stay python",
      "why": "runtime escolhe a ADK e, pelo texto do CRD, determina a imagem do container e o readiness probe. Trocar runtime troca a imagem que roda sem mudar mais nada no manifest."
    },
    {
      "id": "missing-system-message",
      "remove": [
        [
          "spec",
          "declarative",
          "systemMessage"
        ]
      ],
      "expectMessage": "systemMessage is required",
      "why": "Sem systemMessage o agent perde as regras de read-only que o compiler escreve. O prompt e pedido e nao garantia, por isso nao e a fronteira de seguranca, mas faz parte da forma fixa da invariante I3 e fecha o caminho irmao do systemMessageFrom."
    },
    {
      "id": "stream-true",
      "patch": {
        "spec": {
          "declarative": {
            "stream": true
          }
        }
      },
      "expectMessage": "stream must be false",
      "why": "Achado 6 da revisao final: stream era emitido pelo compiler e so permitido pela policy, sem valor fixo."
    },
    {
      "id": "resources-raised",
      "patch": {
        "spec": {
          "declarative": {
            "deployment": {
              "resources": {
                "requests": {
                  "cpu": "4",
                  "memory": "16Gi"
                },
                "limits": {
                  "memory": "32Gi"
                }
              }
            }
          }
        }
      },
      "expectMessage": "deployment.resources must be exactly the compiler's values",
      "why": "Achado 6: resources e o unico limite de custo e de blast radius do agent no namespace compartilhado."
    },
    {
      "id": "resources-cpu-limit-added",
      "patch": {
        "spec": {
          "declarative": {
            "deployment": {
              "resources": {
                "limits": {
                  "cpu": "2",
                  "memory": "1Gi"
                }
              }
            }
          }
        }
      },
      "expectMessage": "deployment.resources must be exactly the compiler's values",
      "why": "Chave a mais em limits: o compiler nao emite limite de CPU, de proposito (throttling em vez de OOMKill)."
    },
    {
      "id": "resources-device-claim",
      "patch": {
        "spec": {
          "declarative": {
            "deployment": {
              "resources": {
                "claims": [
                  {
                    "name": "gpu"
                  }
                ]
              }
            }
          }
        }
      },
      "expectMessage": "deployment.resources must be exactly the compiler's values",
      "why": "resources.claims e propriedade real do CRD que o compiler nao emite: reivindica device fora da cota do namespace."
    },
    {
      "id": "resources-removed",
      "remove": [
        [
          "spec",
          "declarative",
          "deployment",
          "resources"
        ]
      ],
      "expectMessage": "deployment.resources must be exactly the compiler's values",
      "why": "Agent sem resources roda sem teto de memoria. O compiler sempre emite o bloco, logo a ausencia e adulteracao."
    }
  ],
  "modelConfigBase": {
    "apiVersion": "kagent.dev/v1alpha2",
    "kind": "ModelConfig",
    "metadata": {
      "name": "default-model-config",
      "namespace": "kagent"
    },
    "spec": {
      "model": "claude-sonnet",
      "provider": "OpenAI",
      "apiKeySecret": "kagent-aiplat",
      "apiKeySecretKey": "OPENAI_API_KEY",
      "openAI": {
        "baseUrl": "https://ab12cd34ef-vpce-0a1b2c3d4e5f67890.execute-api.us-east-1.amazonaws.com/prod/v1"
      }
    }
  },
  "modelConfigAllow": [
    {
      "id": "model-config-as-bootstrapped",
      "why": "A ModelConfig que scripts/bootstrap-kagent.sh produz passa como esta. Se este caso falhar, a policy esta mais apertada que o bootstrap."
    },
    {
      "id": "model-config-model-change",
      "patch": {
        "spec": {
          "model": "claude-haiku"
        }
      },
      "why": "Trocar o modelo servido pelo gateway e decisao legitima do dono da plataforma: nao muda destino nem credencial."
    },
    {
      "id": "another-model-config-untouched",
      "remove": [
        [
          "spec",
          "openAI"
        ]
      ],
      "patch": {
        "metadata": {
          "name": "outra-model-config"
        },
        "spec": {
          "provider": "Anthropic",
          "anthropic": {
            "baseUrl": "https://api.anthropic.com"
          }
        }
      },
      "why": "Controle de escopo: ModelConfig que nao e a default-model-config nao e avaliada. Agent do builder nao pode referenciar outra, porque o nome esta fixado na governanca."
    }
  ],
  "modelConfigDeny": [
    {
      "id": "model-config-base-url-swap",
      "patch": {
        "spec": {
          "openAI": {
            "baseUrl": "https://api.openai.com/v1"
          }
        }
      },
      "expectMessage": "openAI.baseUrl must be the private AI Gateway endpoint",
      "why": "Achado 3: um patch na ModelConfig manda todo prompt de todos os agents do builder para um endpoint de terceiro, sem tocar manifest nenhum."
    },
    {
      "id": "model-config-public-endpoint-name",
      "patch": {
        "spec": {
          "openAI": {
            "baseUrl": "https://ab12cd34ef.execute-api.us-east-1.amazonaws.com/prod/v1"
          }
        }
      },
      "expectMessage": "openAI.baseUrl must be the private AI Gateway endpoint",
      "why": "O nome publico da MESMA API responde 403 de fora da VPC: so o hostname do VPC endpoint resolve para os IPs privados."
    },
    {
      "id": "model-config-provider-swap",
      "remove": [
        [
          "spec",
          "openAI"
        ]
      ],
      "patch": {
        "spec": {
          "provider": "Anthropic",
          "anthropic": {
            "baseUrl": "https://api.anthropic.com"
          }
        }
      },
      "expectMessage": "must keep provider OpenAI",
      "why": "Outro provider tira o gateway do caminho, e com ele a auditoria e o controle de uso."
    },
    {
      "id": "model-config-secret-swap",
      "patch": {
        "spec": {
          "apiKeySecret": "outro-secret"
        }
      },
      "expectMessage": "must come from the kagent-aiplat secret",
      "why": "O controller resolve o Secret no namespace kagent e tem RBAC para ler Secrets: outro nome le a credencial de outra coisa."
    },
    {
      "id": "model-config-secret-key-swap",
      "patch": {
        "spec": {
          "apiKeySecretKey": "OUTRA_CHAVE"
        }
      },
      "expectMessage": "key OPENAI_API_KEY",
      "why": "Mesma familia do anterior, pela chave dentro do Secret."
    },
    {
      "id": "model-config-api-key-passthrough",
      "patch": {
        "spec": {
          "apiKeyPassthrough": true
        }
      },
      "expectLayer": "schema",
      "expectMessage": "apiKeyPassthrough is forbidden",
      "expectSchemaMessage": "apiKeyPassthrough and apiKeySecret are mutually exclusive",
      "why": "Repassa ao provider o Bearer que chegou na requisicao A2A: a credencial deixa de ser a da plataforma. O CRD recusa primeiro porque apiKeyPassthrough e apiKeySecret são mutuamente exclusivos; a policy mantém o segundo ponto de imposição."
    },
    {
      "id": "model-config-default-headers",
      "patch": {
        "spec": {
          "defaultHeaders": {
            "X-Tenant": "outro"
          }
        }
      },
      "expectMessage": "defaultHeaders and openAI.tokenExchange are forbidden",
      "why": "Header fixo em todo request ao gateway muda quem o gateway ve chamando."
    },
    {
      "id": "model-config-token-exchange",
      "patch": {
        "spec": {
          "openAI": {
            "tokenExchange": {
              "type": "GDCHServiceAccount",
              "gdchServiceAccount": {
                "audience": "https://gdc.example"
              }
            }
          }
        }
      },
      "expectMessage": "defaultHeaders and openAI.tokenExchange are forbidden",
      "why": "Troca credencial por um bearer dinamico antes da chamada ao modelo."
    },
    {
      "id": "model-config-tls-disable-verify",
      "patch": {
        "spec": {
          "tls": {
            "disableVerify": true
          }
        }
      },
      "expectMessage": "spec.tls is forbidden",
      "why": "Com a verificacao desligada, a URL certa aceita um endpoint que nao e o gateway."
    },
    {
      "id": "model-config-tls-custom-ca",
      "patch": {
        "spec": {
          "tls": {
            "caCertSecretRef": "ca-do-atacante",
            "caCertSecretKey": "ca.crt"
          }
        }
      },
      "expectMessage": "spec.tls is forbidden",
      "why": "Trocar a ancora de confianca tem o mesmo efeito de desligar a verificacao, de forma mais silenciosa."
    },
    {
      "id": "model-config-second-provider-block",
      "patch": {
        "spec": {
          "bedrock": {
            "region": "us-east-1"
          }
        }
      },
      "expectLayer": "schema",
      "expectMessage": "only the openAI provider block is allowed",
      "expectSchemaMessage": "provider.bedrock must be nil if the provider is not Bedrock",
      "why": "Segundo ponto de imposição do provider, independente do pin de provider. O CRD recusa primeiro porque o bloco não corresponde ao provider OpenAI; a policy mantém o segundo ponto de imposição."
    }
  ],
  "dualEnforced": [
    {
      "messageContains": "spec is required",
      "reason": "O CRD declara default para spec.type, logo o API server materializa spec em todo objeto e esta validacao nunca dispara. Fica como guarda fail-closed se o default sair numa versao futura."
    },
    {
      "messageContains": "spec.declarative is required",
      "reason": "A XValidation do proprio CRD ja exige (type==Declarative && has(declarative)) || (type==BYO && has(byo)). Segundo ponto de imposicao, no schema."
    },
    {
      "messageContains": "spec.type must be Declarative",
      "reason": "O CRD limita type ao enum [Declarative, BYO] e exige o bloco correspondente. O caso type-byo e negado pelo schema, com expectLayer schema."
    },
    {
      "messageContains": "every tool must be type McpServer",
      "reason": "O CRD limita tools[].type ao enum [McpServer, Agent] e a validacao seguinte exige mcpServer com o nome do tool server do builder, o que uma tool type Agent nao tem. Mantida porque e a unica que nomeia a ameaca de delegacao entre agents."
    },
    {
      "messageContains": "apiKeyPassthrough is forbidden",
      "reason": "O CRD v0.9.9 já torna apiKeyPassthrough e apiKeySecret mutuamente exclusivos. A policy mantém um segundo ponto de imposição caso o schema seja relaxado numa versão futura."
    },
    {
      "messageContains": "must keep provider OpenAI",
      "reason": "A policy também exige o bloco openAI.baseUrl, e o CRD exige que o bloco corresponda ao provider. Remover apenas este pin continua negando qualquer provider alternativo pelas duas regras restantes."
    },
    {
      "messageContains": "only the openAI provider block is allowed",
      "reason": "O CRD v0.9.9 exige que o bloco de provider corresponda ao provider escolhido. A policy fixa novamente apenas openAI para proteger contra relaxamento futuro do schema."
    }
  ],
