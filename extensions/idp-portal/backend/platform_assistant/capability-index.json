     },
     "environment": {
      "default": "dev",
      "enum": [
       "dev",
       "lab",
       "internal",
       "demo",
       "prod"
      ],
      "type": "string"
     },
     "healthPath": {
      "default": "/health",
      "type": "string"
     },
     "image": {
      "description": "Inference server image (vLLM, TGI, Triton, custom FastAPI).",
      "type": "string"
     },
     "modelId": {
      "default": "",
      "type": "string"
     },
     "name": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$",
