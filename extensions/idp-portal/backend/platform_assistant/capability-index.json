  "compute/lambda/v1": {
   "apiVersion": "kro.run/v1alpha1",
   "argoApplication": "agent-platform-instances",
   "cost": null,
   "deletionPolicy": "retain",
   "displayName": "Lambda function",
   "displayNamePt": "Função Lambda",
   "goldenPath": "GP-I1",
   "id": "compute/lambda/v1",
   "kind": "LambdaFunction",
   "lifecycle": "preview",
   "outputs": [
    "functionArn",
    "functionName"
   ],
   "owner": "platform-team",
   "readyCondition": "ACK.ResourceSynced",
   "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
     "environment": {
      "default": "dev",
      "type": "string"
     },
     "environmentVariables": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "handler": {
      "default": "main.lambda_handler",
      "type": "string"
     },
     "name": {
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "type": "string"
     },
     "roleArn": {
      "pattern": "^arn:aws:iam::",
      "type": "string"
     },
     "runtime": {
      "default": "python3.12",
      "enum": [
       "python3.12",
       "python3.13",
       "nodejs22.x"
      ],
      "type": "string"
     },
     "s3Bucket": {
      "type": "string"
     },
     "s3Key": {
      "type": "string"
     },
     "size": {
      "default": "medium",
      "description": "small=256MB medium=1024MB large=2048MB xlarge=4096MB",
      "enum": [
       "small",
       "medium",
       "large",
       "xlarge"
      ],
      "type": "string"
     },
     "timeout": {
      "default": 30,
      "maximum": 900,
      "minimum": 3,
      "type": "integer"
     }
    },
    "required": [
     "name",
     "s3Bucket",
     "s3Key",
     "roleArn"
    ],
    "title": "LambdaFunction",
    "type": "object"
   }
  },
