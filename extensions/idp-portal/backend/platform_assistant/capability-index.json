  "frontend/static-site/v1": {
   "apiVersion": "kro.run/v1alpha1",
   "argoApplication": "agent-platform-instances",
   "cost": null,
   "deletionPolicy": "retain",
   "displayName": "Static site bucket",
   "displayNamePt": "Bucket de site estático",
   "goldenPath": "GP-A3",
   "id": "frontend/static-site/v1",
   "kind": "StaticSite",
   "lifecycle": "preview",
   "outputs": [
