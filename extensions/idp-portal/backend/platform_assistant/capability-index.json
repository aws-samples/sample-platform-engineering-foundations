  "frontend/static-web-app/v1": {
   "apiVersion": "kro.run/v1alpha1",
   "argoApplication": "agent-platform-instances",
   "cost": null,
   "deletionPolicy": "retain",
   "displayName": "Static web app (CloudFront + S3)",
   "displayNamePt": "Web app estática (CloudFront + S3)",
   "goldenPath": "GP-A",
   "id": "frontend/static-web-app/v1",
   "kind": "StaticWebApp",
   "lifecycle": "available",
   "outputs": [
    "bucketArn",
    "bucketName",
    "distributionId",
    "distributionStatus",
    "domainName",
    "url"
   ],
   "owner": "platform-team",
   "readyCondition": "ACK.ResourceSynced",
   "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
     "contentSecurityPolicy": {
      "default": "default-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'",
      "type": "string"
     },
     "deletionPolicy": {
      "default": "retain",
      "description": "delete só com lifecycle ephemeral; imutável depois da criação",
      "enum": [
       "retain",
       "delete"
      ],
      "type": "string"
     },
     "environment": {
      "default": "dev",
      "enum": [
       "dev",
       "lab",
       "internal",
       "demo",
       "prod"
      ],
      "type": "string"
     },
     "expiresAt": {
      "default": "",
      "description": "ISO 8601 UTC; obrigatório quando lifecycle é ephemeral",
      "type": "string"
     },
     "indexDocument": {
      "default": "index.html",
      "type": "string"
     },
     "lifecycle": {
      "default": "persistent",
      "description": "ephemeral só no espaço de nomes reservado (tour-*), com expiresAt; o reaper abre o MR de remoção ao vencer",
      "enum": [
       "persistent",
       "ephemeral"
      ],
      "type": "string"
     },
     "name": {
      "description": "Global bucket name; include a unique suffix such as the account id.",
      "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$",
      "type": "string"
     },
     "owner": {
      "default": "platform-team",
      "type": "string"
     },
     "priceClass": {
      "default": "PriceClass_100",
      "enum": [
       "PriceClass_100",
       "PriceClass_200",
       "PriceClass_All"
      ],
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "title": "StaticWebApp",
    "type": "object"
   }
  }
 },
