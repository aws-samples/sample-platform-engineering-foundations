{
 "capabilities": {
  "app/serverless-multi-tier/v1": {
   "apiVersion": "kro.run/v1alpha1",
   "argoApplication": "agent-platform-instances",
   "cost": null,
   "deletionPolicy": "retain",
   "displayName": "Serverless multi-tier app",
   "displayNamePt": "App serverless multi-tier",
   "goldenPath": "GP-A1",
   "id": "app/serverless-multi-tier/v1",
   "kind": "ServerlessMultiTier",
   "lifecycle": "preview",
   "outputs": [
    "apiEndpoint",
    "frontendBucket",
    "functionArn",
    "postsTableArn",
    "usersTableArn"
   ],
   "owner": "platform-team",
   "readyCondition": "ACK.ResourceSynced",
   "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
     "bucketSuffix": {
      "type": "string"
     },
     "environment": {
      "default": "dev",
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "s3Bucket": {
      "type": "string"
     },
     "s3Key": {
      "default": "function-python-users-posts.zip",
      "type": "string"
     },
     "size": {
      "default": "medium",
      "enum": [
       "small",
       "medium",
       "large",
       "xlarge"
      ],
      "type": "string"
     }
    },
    "required": [
     "name",
     "s3Bucket",
     "bucketSuffix"
    ],
    "title": "ServerlessMultiTier",
    "type": "object"
   }
  },
  "compute/inference-ecs/v1": {
   "apiVersion": "kro.run/v1alpha1",
   "argoApplication": "agent-platform-instances",
   "cost": null,
   "deletionPolicy": "retain",
   "displayName": "Model inference on ECS Fargate",
   "displayNamePt": "Inference de modelo no ECS Fargate",
   "goldenPath": "GP-B",
   "id": "compute/inference-ecs/v1",
   "kind": "InferenceECS",
   "lifecycle": "preview",
   "outputs": [
    "clusterArn",
    "runningCount",
    "serviceArn",
    "serviceStatus"
   ],
   "owner": "platform-team",
   "readyCondition": "ACK.ResourceSynced",
   "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "containerPort": {
      "default": 8080,
      "type": "integer"
     },
     "environment": {
      "default": "dev",
      "enum": [
       "dev",
       "lab",
       "internal",
       "demo",
       "prod"
      ],
      "type": "string"
     },
     "healthPath": {
      "default": "/health",
      "type": "string"
     },
     "image": {
      "description": "Inference server image (vLLM, TGI, Triton, custom FastAPI).",
      "type": "string"
     },
     "modelId": {
      "default": "",
      "type": "string"
     },
     "name": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$",
      "type": "string"
     },
     "owner": {
      "default": "platform-team",
      "type": "string"
     }
    },
    "required": [
     "name",
     "image"
    ],
    "title": "InferenceECS",
    "type": "object"
   }
  },
